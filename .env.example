# All variables are optional. Copy to .env and change only what you need.
# Without a .env file the app uses the free public OpenStreetMap services.

# Comma-separated Overpass API servers, tried in order until one answers
VITE_OVERPASS_URLS=https://overpass-api.de/api/interpreter,https://overpass.private.coffee/api/interpreter,https://maps.mail.ru/osm/tools/overpass/api/interpreter

# Nominatim endpoint used to turn a typed city/address into coordinates
VITE_NOMINATIM_URL=https://nominatim.openstreetmap.org/search

# Search radius in metres (capped at 5000)
VITE_SEARCH_RADIUS_M=1500
