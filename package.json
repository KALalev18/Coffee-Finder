{
  "name": "coffee-finder",
  "version": "1.0.0",
  "private": true,
  "description": "Swipe through cafés near you, save the ones you like, and see them on a map.",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @coffee-finder/web --",
    "dev:api": "npm run dev -w @coffee-finder/api --",
    "build": "npm run build -w @coffee-finder/web -w @coffee-finder/api",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "npm run typecheck --workspaces",
    "test": "npm run test --workspaces",
    "test:e2e": "npm run test:e2e -w @coffee-finder/web",
    "check": "npm run lint && npm run format:check && npm run typecheck && npm test"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/node": "22.19.3",
    "eslint": "9.39.5",
    "eslint-plugin-react-hooks": "5.1.0",
    "eslint-plugin-react-refresh": "0.4.16",
    "globals": "15.14.0",
    "prettier": "3.4.2",
    "typescript": "5.7.2",
    "typescript-eslint": "8.72.0",
    "vitest": "5.0.5"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  }
}
