# All variables are optional. Copy to .env and change only what you need.
# The API holds no secrets: OpenStreetMap services need no key.

PORT=3001
HOST=0.0.0.0
LOG_LEVEL=info

# Comma-separated origins allowed to call the API from a browser
CORS_ORIGINS=http://localhost:5173

# Set to true behind a proxy or load balancer (Render, Fly, Cloud Run) so rate limits use the client IP
TRUST_PROXY=false

# Upstream services
OVERPASS_URLS=https://overpass-api.de/api/interpreter,https://overpass.private.coffee/api/interpreter,https://maps.mail.ru/osm/tools/overpass/api/interpreter
NOMINATIM_URL=https://nominatim.openstreetmap.org/search

# Café results are cached per ~280 m grid cell for this long; geocoding results for 24 hours
CACHE_TTL_SECONDS=600
CACHE_MAX_ENTRIES=1000

# Requests per minute per client IP for /api/* routes
RATE_LIMIT_PER_MINUTE=30

# Sent in the User-Agent header, as the OpenStreetMap usage policies ask
CONTACT_URL=https://github.com/KALalev18/Coffee-Finder
