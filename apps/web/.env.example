# All variables are optional. Copy to .env and change only what you need.

# URL of the Coffee Finder API (apps/api). When empty, the browser calls the public
# OpenStreetMap services directly, which is how the static GitHub Pages build works.
VITE_API_URL=

# Set to true to build a demo that only uses bundled sample data (same as adding ?demo to the URL)
VITE_DEMO=false

# Used only when VITE_API_URL is empty: Overpass servers tried in order, and the Nominatim endpoint
VITE_OVERPASS_URLS=https://overpass-api.de/api/interpreter,https://overpass.private.coffee/api/interpreter,https://maps.mail.ru/osm/tools/overpass/api/interpreter
VITE_NOMINATIM_URL=https://nominatim.openstreetmap.org/search

# Default search radius in metres (capped at 5000)
VITE_SEARCH_RADIUS_M=1500
